GOOGLE_API_KEY="your-gemini-api-key-here"
GEMINI_API_KEY="your-gemini-api-key-here"

# Optional: Web search
TAVILY_API_KEY=""

# Optional: LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=""
LANGCHAIN_PROJECT="module3_production_ready"


# --- Mail transport (DJEF Email Assistant) -------------------------------
# by Kassouar Fatima 🇩🇿 - Module 3 - Production-Ready Agent.
#
# Leave EMAIL_PASSWORD empty to use the built-in demo inbox (works offline).
# Fill it with a 16-character Gmail App Password to send/receive real mail:
#   https://myaccount.google.com/apppasswords   (2-Step Verification required)
EMAIL_ADDRESS=kassouarfatima@gmail.com
EMAIL_PASSWORD=

# auto | real | simulated
MAIL_MODE=auto

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
