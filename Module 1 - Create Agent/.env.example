# --- Module 1 - Create Agent ---------------------------------------
# Copy this file to `.env` at the root (or into djef_chef/) and
# fill in your real keys. The .env file is ignored by git.

# Gemini (required for all 4 notebooks)
GOOGLE_API_KEY="your_google_api_key"
GEMINI_API_KEY="your_google_api_key"

# Tavily — web search (lesson 1_2 and the DJEF project)
TAVILY_API_KEY="your_tavily_api_key"

# DJEF project model
CHEF_MODEL="gemini-3.5-flash-lite"
CHEF_TEMPERATURE="0.35"

# LangSmith tracing (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=""
LANGCHAIN_PROJECT="personal_chef"