# Required: Gemini chat model
GEMINI_API_KEY="your_gemini_api_key"

# Recommended: live recipe search through Tavily
TAVILY_API_KEY="your_tavily_api_key"

# Optional model configuration
CHEF_MODEL="gemini-3.6-flash"
CHEF_TEMPERATURE="0.35"

# Optional LangSmith tracing (current LangSmith variable names)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=""
LANGCHAIN_PROJECT="personal_chef"
